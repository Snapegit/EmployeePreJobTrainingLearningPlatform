<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cl.dao.XuexixinxiDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.cl.entity.XuexixinxiEntity" id="xuexixinxiMap">
        <result property="ziyuanmingcheng" column="ziyuanmingcheng"/>
        <result property="kechengfenlei" column="kechengfenlei"/>
        <result property="jianshu" column="jianshu"/>
        <result property="daoshizhanghao" column="daoshizhanghao"/>
        <result property="daoshixingming" column="daoshixingming"/>
        <result property="xueshengshijian" column="xueshengshijian"/>
        <result property="yuangonggonghao" column="yuangonggonghao"/>
        <result property="yuangongxingming" column="yuangongxingming"/>
    </resultMap>

    <select id="selectListView"
		resultType="com.cl.entity.view.XuexixinxiView" >

		SELECT  xuexixinxi.* FROM xuexixinxi  xuexixinxi 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.cl.entity.view.XuexixinxiView" >
		SELECT * FROM xuexixinxi  xuexixinxi <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectGroupBy"
		resultType="com.cl.entity.view.XuexixinxiView" >
		select userid,username,paperid,papername,sum(myscore) myscore,ROUND(sum(case when myscore>0 then 1 else 0 end)/(sum(1)),2) accuracy from examrecord     
        <where> 1=1 ${ew.sqlSegment}</where>
        group by userid,username,paperid,papername  
	</select>

</mapper>

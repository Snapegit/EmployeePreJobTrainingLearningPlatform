<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cl.dao.ZhidaozixunDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.cl.entity.ZhidaozixunEntity" id="zhidaozixunMap">
        <result property="daoshizhanghao" column="daoshizhanghao"/>
        <result property="daoshixingming" column="daoshixingming"/>
        <result property="zixunwenti" column="zixunwenti"/>
        <result property="zixunshijian" column="zixunshijian"/>
        <result property="yuangonggonghao" column="yuangonggonghao"/>
        <result property="yuangongxingming" column="yuangongxingming"/>
        <result property="shhf" column="shhf"/>
    </resultMap>

    <select id="selectListView"
		resultType="com.cl.entity.view.ZhidaozixunView" >

		SELECT  zhidaozixun.* FROM zhidaozixun  zhidaozixun 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.cl.entity.view.ZhidaozixunView" >
		SELECT * FROM zhidaozixun  zhidaozixun <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectGroupBy"
		resultType="com.cl.entity.view.ZhidaozixunView" >
		select userid,username,paperid,papername,sum(myscore) myscore,ROUND(sum(case when myscore>0 then 1 else 0 end)/(sum(1)),2) accuracy from examrecord     
        <where> 1=1 ${ew.sqlSegment}</where>
        group by userid,username,paperid,papername  
	</select>

</mapper>
